{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "PMO 项目全流程操作",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "setup",
        "label": "准备：建群与计划",
        "focus": [
          "program",
          "project",
          "plan",
          "baseline"
        ],
        "note": "先把项目群、双方项目经理、WBS 和基线定下来，再开始按周执行。"
      },
      {
        "id": "run",
        "label": "执行：周报与审核",
        "focus": [
          "weekly",
          "review"
        ],
        "note": "周报自动带出本周计划任务，PMO 审核通过或退回修改。"
      },
      {
        "id": "close",
        "label": "收口：关口与验收",
        "focus": [
          "gate_review",
          "acceptance"
        ],
        "note": "关口必检项完成后再验收；范围或工期变化走变更并重设基线。"
      },
      {
        "id": "collab",
        "label": "协作：会议与用品",
        "focus": [
          "collab_request",
          "collab_approve",
          "collab_exec"
        ],
        "note": "项目执行期间可发起会议室预订或办公用品领用；审批人不能是申请人，通过后会议进入日历、用品发放并扣库存。"
      }
    ]
  },
